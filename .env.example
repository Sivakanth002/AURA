# ==============================================================================
# AURA (Autonomous Assistive Robotics Agent) Configuration
# ==============================================================================

# Execution Mode: sim (Pure Python 2D Grid World) or ros2 (ROS 2 Jazzy Bridge)
AURA_EXECUTION_MODE=sim

# LLM Provider: fallback (Deterministic Zero-LLM mode), openai, gemini, or local
AURA_LLM_PROVIDER=fallback

# API Keys (Optional - only required if AURA_LLM_PROVIDER is not 'fallback')
OPENAI_API_KEY=
GEMINI_API_KEY=
LOCAL_MODEL_ENDPOINT=http://localhost:11434/v1

# Dashboard Server Settings
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
